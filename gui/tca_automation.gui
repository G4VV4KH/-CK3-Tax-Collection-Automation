types TcaAutomationTypes {
type tca_manage_context_worker = widget {
size = { 1 1 }
widget = {
size = { 1 1 }
alwaystransparent = yes
state = { name = tca_local_noop alpha = 1 }
state = { name = tca_manager_created trigger_on_create = yes alpha = 1 on_start = "[GetVariableSystem.Clear('tca_manage_context_owner')]" }
state = {
name = tca_publish_manager_owner
alpha = 1
trigger_when = "[And( IsGameViewOpen('manage_tax_slots'), And( ManageTaxSlotsWindow.GetLiege.IsValid, Not( GetVariableSystem.HasValue('tca_manage_context_owner', UIntToString(ManageTaxSlotsWindow.GetLiege.GetID)) ) ) )]"
duration = 0
on_finish = "[PdxGuiWidget.TriggerAnimation(Select_CString(And( IsGameViewOpen('manage_tax_slots'), And( ManageTaxSlotsWindow.GetLiege.IsValid, Not( GetVariableSystem.HasValue('tca_manage_context_owner', UIntToString(ManageTaxSlotsWindow.GetLiege.GetID)) ) ) ), 'tca_publish_manager_owner_finish_action', 'tca_local_noop'))]"
}
state = {
name = tca_publish_manager_owner_finish_action
alpha = 1
on_start = "[GetVariableSystem.Set('tca_manage_context_owner', UIntToString(ManageTaxSlotsWindow.GetLiege.GetID))]"
}state = {
name = tca_cancel_manager_owner
alpha = 1
trigger_when = "[Not( IsGameViewOpen('manage_tax_slots') )]"
}
}
}
type tca_automation_controls = vbox {
layoutpolicy_horizontal = expanding
button_checkbox_label = {
name = tca_automation_toggle
layoutpolicy_horizontal = expanding
enabled = "[GetScriptedGui('tca_toggle_automation').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
onclick = "[GetScriptedGui('tca_toggle_automation').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
tooltip = "tca_automation_tooltip"
blockoverride "checkbox" { checked = "[GetPlayer.MakeScope.GetVariable('tca_enabled').IsSet]" }
blockoverride "text" { text = "tca_automation_label" max_width = 460 }
}
text_multi = {
visible = "[GetPlayer.MakeScope.GetVariable('tca_swap_tx_blocked').IsSet]"
text = "tca_automation_recovery_warning"
max_width = 460
autoresize = yes
default_format = "#warning"
using = Font_Size_Small
}
}
